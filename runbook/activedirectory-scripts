## Code

```powershell
# ============================================================
# INTERACTIVE NEW USER CREATION - WITH LOOP
# ============================================================

Import-Module ActiveDirectory
Clear-Host

# Resolve domain info once up front
$Domain  = (Get-ADDomain).DNSRoot
$BaseDN  = (Get-ADDomain).DistinguishedName

do {
    Clear-Host
    Write-Host "`n=== NEW USER CREATION ===" -ForegroundColor Cyan
    Write-Host "Enter the information below:`n" -ForegroundColor Yellow

    # --- Basic info ---
    $FirstName  = Read-Host "First Name"
    $LastName   = Read-Host "Last Name"
    $SamAccount = Read-Host "Username (SAM account)"
    $Department = Read-Host "Department (e.g., IT, HR, Sales)"
    $Title      = Read-Host "Job Title"

    if ([string]::IsNullOrWhiteSpace($FirstName) -or
        [string]::IsNullOrWhiteSpace($LastName) -or
        [string]::IsNullOrWhiteSpace($SamAccount)) {
        Write-Host "`nFirst name, last name, and username are required." -ForegroundColor Red
        Start-Sleep -Seconds 2
        continue
    }

    if (Get-ADUser -Filter "SamAccountName -eq '$SamAccount'" -ErrorAction SilentlyContinue) {
        Write-Host "`nA user with SAM account '$SamAccount' already exists." -ForegroundColor Red
        Start-Sleep -Seconds 2
        continue
    }

    $UPN   = "$SamAccount@$Domain"
    $Group = "$Department-Staff"

    $addToGroup = Read-Host "Create/add to group '$Group'? (y/n)"

    # OU mapping — built from the domain's actual base DN
    switch ($Department) {
        "IT"    { $OU = "OU=IT,$BaseDN" }
        "HR"    { $OU = "OU=HR,$BaseDN" }
        "Sales" { $OU = "OU=Sales,$BaseDN" }
        default { $OU = "OU=Users,$BaseDN" }
    }

    # --- Password input (masked, no plaintext echo) ---
    Write-Host "`nEnter initial password twice:" -ForegroundColor Yellow
    $SecurePW1 = Read-Host "New Password" -AsSecureString
    $SecurePW2 = Read-Host "Confirm Password" -AsSecureString

    $BSTR1 = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePW1)
    $BSTR2 = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($SecurePW2)
    $PW1Plain = [Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR1)
    $PW2Plain = [Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR2)
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($BSTR1)
    [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($BSTR2)

    if ($PW1Plain -ne $PW2Plain) {
        Write-Host "`nPasswords do not match!" -ForegroundColor Red
        $PW1Plain = $null; $PW2Plain = $null
        Start-Sleep -Seconds 2
        continue
    }

    $Password    = $SecurePW1
    $PW1Plain    = $null
    $PW2Plain    = $null
    $DisplayName = "$FirstName $LastName"

    try {
        # Group creation/add happens inside the same try block now
        if ($addToGroup -eq 'y' -or $addToGroup -eq 'Y') {
            if (-not (Get-ADGroup -Filter "Name -eq '$Group'" -ErrorAction SilentlyContinue)) {
                New-ADGroup -Name $Group -GroupScope Global -Path $OU -GroupCategory Security -ErrorAction Stop | Out-Null
                Write-Host "Created group: $Group" -ForegroundColor Green
            }
        }

        New-ADUser `
            -Name $DisplayName `
            -GivenName $FirstName `
            -Surname $LastName `
            -DisplayName $DisplayName `
            -SamAccountName $SamAccount `
            -UserPrincipalName $UPN `
            -Path $OU `
            -Department $Department `
            -Title $Title `
            -AccountPassword $Password `
            -Enabled $true `
            -ChangePasswordAtLogon $true `
            -ErrorAction Stop

        Write-Host "`n✓ User '$DisplayName' created successfully!" -ForegroundColor Green
        Write-Host "  Login: $UPN"
        Write-Host "  OU:    $OU"

        if ($addToGroup -eq 'y' -or $addToGroup -eq 'Y') {
            Add-ADGroupMember -Identity $Group -Members $SamAccount -ErrorAction Stop
            Write-Host "  Group: Added to $Group"
        }

        Write-Host "`nVerification:" -ForegroundColor Yellow
        Get-ADUser -Identity $SamAccount -Properties Department, Title, MemberOf |
            Select-Object Name, SamAccountName, UserPrincipalName, Department, Title, @{Name="Groups";Expression={$_.MemberOf}} |
            Format-List

    } catch {
        Write-Host "`n✗ Error: $_" -ForegroundColor Red
    } finally {
        # Clear password material regardless of success/failure
        $Password = $null
        [System.GC]::Collect()
    }

    $continue = Read-Host "`nCreate another user? (y/n)"

} while ($continue -eq 'y' -or $continue -eq 'Y')

Write-Host "`n=== Session Complete ===" -ForegroundColor Cyan
```

